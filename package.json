{
  "name": "frame-shifter-v2",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "@nuxt/cli": "3.32.0",
      "crossws": "0.3.5"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:collab": "wrangler dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "nuxt typecheck",
    "typecheck:collab": "tsc -p workers/collab",
    "deploy:collab": "wrangler deploy"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@sentry/nuxt": "10.70.0",
    "date-fns": "4.1.0",
    "nuxt": "4.2.2",
    "nuxt-maplibre": "1.2.2",
    "papaparse": "5.5.3",
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "vue": "3.5.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@nuxt/test-utils": "4.0.2",
    "@playwright/test": "1.59.1",
    "@types/papaparse": "5.5.2",
    "@vue/test-utils": "2.4.8",
    "happy-dom": "20.9.0",
    "playwright-core": "1.59.1",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "vue-tsc": "3.3.9",
    "wrangler": "4.121.0"
  }
}
